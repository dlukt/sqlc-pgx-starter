# Application
APP_ENV=development
HTTP_ADDR=:8080

# Compose a full DSN by leaving DATABASE_URL empty and filling the DB_* values,
# or set DATABASE_URL directly and the DB_* values are ignored.
DATABASE_URL=

# Individual connection fields (used only when DATABASE_URL is empty).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=appdb
DB_SSLMODE=disable
